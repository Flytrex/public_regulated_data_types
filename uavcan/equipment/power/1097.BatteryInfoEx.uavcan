#
# Extended Battery Info for Flytrex Battery
# https://docs.google.com/spreadsheets/d/1uEEfnQlMEymqpjMPGG-jhk5R2maAyZMZhrMTCv0htKY/edit#gid=1073892483
#

float32 charge_intergrator_ah                                               # [A x h] Charge Integrator Value from BQ76952
float16 cfet_temp_dc                                                        # [°C] Charge FET Group Temperature
float16 dfet_temp_dc                                                        # [°C] Discharge FET Group Temperature
float16 pcb_temp_bq_dc                                                      # [°C] Temperature from BQ76952 internal sensor
float16 rear_cell_temp_dc                                                   # [°C] Real Cell Sensor Temp
float16 cell_board_temp_dc                                                  # [°C] Cell Interconnect Board Temp sensor
float16 front_cell_temp_dc                                                  # [°C] Front Cell Temp sensor
float16 load_voltage_v                                                      # [V] Voltage at PACK+ connection
float16 charger_voltage_v                                                   # [V] Voltage at CHARGE connection
float16 pack_voltage_v                                                      # [V] Voltage of the cell stack
float16 current_a                                                           # [A] Decision Current (battery current averaged over 500 ms)
float16[12] cell_voltage_v                                                  # [V] Per-cell voltages
float16 max_cell_v                                                          # [V] Max cell voltage
float16 min_cell_v                                                          # [V] Min cell voltage
float16 stack_delta_v                                                       # [V] sum(cell_voltage_v) - pack_voltage_v
uint7 relative_soc_pct                                                      # [%] Relative SoC (assumed 100% at charge voltage)
float16 non_clamped_soc                                                     # [0..1] Intermediate SoC before clamping to [0..1]
uint8 active_bq_alert_code                                                  # [Enum] BQ76952 highest priority active alert

uint36 CUV                                      = 1                         # Cell undervoltage
uint36 OVC                                      = 2                         # Overcurrent
uint36 COV                                      = 4                         # Cell overvoltage
uint36 OTHER_HW_FAULT                           = 8                         # Hardware fault
uint36 TOSF                                     = 16                        # fabs(sum(cell_voltage_v) - pack_voltage_v) too high
uint36 FATAL_CUV                                = 32                        # Fatal cell undervoltage
uint36 BAD_TEMP_SENSOR                          = 64                        # Invalid temperature sensor
uint36 FATAL_COV                                = 128                       # Fata cell overvoltage
uint36 DCF                                      = 256                       # Discharge circuit hardware failure
uint36 CCF                                      = 512                       # Charge circuit hardware failure
uint36 INTEGRATOR_UNRELIABLE                    = 1024                      # Unreliable SoC integrator
uint36 OUT_OF_BALANCE                           = 2048                      # Large differences between cells
uint36 BQ_COMMS_FAILURE                         = 4096                      # BQ76952 not accessible
uint36 CONFIG_UNACCEPTABLE                      = 8192                      # BQ76952 misconfigured
uint36 OTHER_SW_FAULT                           = 16384                     # Undefined software fault
uint36 NONSTANDARD_MODE                         = 32768                     # BMS in factory mode(s) 
uint36 DANGEROUS_CONFIG_ITEM                    = 64536                     # Testing config item activated, battery may misbehave
uint36 LO_VOLTAGE_DIFFERENCE                    = 131072                    # Large voltage difference between batteries
uint36 RESERVED1                                = 262144                    # RESERVED1
uint36 LO_UNSAFE_TEMP                           = 524288                    # Temperature not safe to enable output
uint36 LO_HW_FAULT                              = 1048576                   # Other hardware fault prevents enabling the output
uint36 LO_OTHER_UNSAFE                          = 2097152                   # Other battery is in an unsafe state
uint36 LO_CHARGING_SEPARATION                   = 4194304                   # Battery output disabled for charging
uint36 LO_OTHER_NOT_IN_USE                      = 8388608                   # Other battery is not in use
uint36 CHG_TOO_HOT                              = 16777216                  # Too hot for charging
uint36 CHG_TOO_COLD                             = 33554432                  # Too cold for charging 
uint36 CHG_PRESENT                              = 67108864                  # Charger is present
uint36 CHG_REQUESTED                            = 134217728                 # Charging is requested
uint36 RESERVED2                                = 268435456                 # RESERVED2
uint36 RESERVED3                                = 536870912                 # RESERVED3
uint36 TH_WARNING                               = 1073741824                # High temp warning
uint36 TH_FATAL                                 = 2147483648                # Fatal overtemperature
uint36 TC_WARNING                               = 4294967296                # Low temp warning
uint36 TC_FATAL                                 = 8589934592                # Fatal undertemperature
uint36 RESERVED4                                = 17179869184               # RESERVED4
uint36 RESERVED5                                = 34359738368               # RESERVED5
uint36 extended_status                                                      # Bitfield

uint16 balanced_cells                                                       # [Bitfield] Each bit represents a cell that's being discharged to balance the pack
float32 lifetime_charge_ah                                                  # [A x h] Battery Mileage, total charge that passed through the battery      
uint32 bq_config_crc                                                        # [uint32] CRC signature of the current BQ76952 config
